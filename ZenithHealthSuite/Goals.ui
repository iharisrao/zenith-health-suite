  <property name="styleSheet">
   <string notr="true">#headerWidget {
    background-color: transparent;
    border-bottom: none;
}

QLabel#lblHeaderTitle {
    color: #1558A8;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
}

#headerWidget QPushButton {
    background-color: transparent;
    border: none;
    color: #8C98A4;
    font-size: 14px;
    font-weight: bold;
    padding: 5px 10px;
}

#headerWidget QPushButton:hover {
    color: #1558A8;
}

#navOverviewButton {
    color: #1558A8 !important;
    border-bottom: 3px solid #1558A8;
    border-radius: 0px;
}

QLabel {
    font-family: 'Segoe UI', 'Roboto', sans-serif;
}

#sidebarWidget {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
    min-width: 260px; 
}

#appNameLabel {
    color: #1558A8;
    font-size: 18px;
    font-weight: 800;
    padding: 5px 15px 0px 15px;
    background-color: transparent;
    margin-top: 0px;
    border: none;
    min-height: 30px;
    max-height: 35px;
}

#sidebarWidget QPushButton {
    text-align: left;
    padding: 8px 20px;
    background-color: transparent;
    border: none;
    color: #6B7280; 
    font-size: 14px;
    font-weight: 600;
    margin: 2px 15px; 
    border-radius: 8px;
    min-height: 34px; 
}

#sidebarWidget QPushButton:hover {
    background-color: #F0F7FF; 
    color: #1558A8;            
}

QPushButton#goalsButton {
    background-color: #F0F7FF !important;
    color: #1558A8 !important;
    font-weight: 900 !important;
    border-left: 4px solid #1558A8 !important;
    border-radius: 0px 8px 8px 0px !important;
}

#frameActiveGoals, #frameCompletionRate {
    background-color: transparent;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
}

#lblActiveGoalsText, #lblCompletionRateText {
    color: #6B7280;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}

#lblActiveGoalsValue, #lblCompletionRateValue {
    color: #1558A8;
    font-size: 18px;
    font-weight: bold;
}

#formFrame {
    background-color: #F8FAFC; 
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

#formFrame QLabel {
    color: #6B7280;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

#formFrame QLineEdit, #formFrame QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 8px 12px;
    color: #4B5563;
    font-size: 13px;
}

#btnDaily, #btnWeekly, #btnQuarterly {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 8px 15px;
    color: #4B5563;
    font-weight: bold;
    font-size: 11px;
}

#btnDaily:checked, #btnWeekly:checked, #btnQuarterly:checked {
    background-color: #0A3D91; 
    color: #FFFFFF;
    border: 1px solid #0A3D91;
}


#comboCategory::drop-down {
    border: none;
    width: 0px;
}

#comboCategory::down-arrow {
    image: none;
}</string>
