    <property name="styleSheet">
     <string notr="true">/* 1. Main Card ka White Background aur Rounded Corners */
#cardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

/* 2. Main Title (Cardiovascular Endurance) */
#cardFrame #lblTitle {
    color: #0F172A;
    font-size: 16px;
    font-weight: bold;
    border: none;
}

/* 3. Subtitle (Target: 45...) */
#cardFrame #lblTargetDesc {
    color: #64748B;
    font-size: 12px;
    border: none;
}

/* 4. Icon Dabba (Light Blue Box) */
#cardFrame #lblIcon {
    background-color: #E0E7FF;
    border-radius: 6px;
    border: none;
}

/* 5. Category Badge (STRATEGIC) */
#cardFrame #lblCategory {
    background-color: #F1F5F9;
    color: #334155;
    font-size: 10px;
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid #E2E8F0;
}

/* 6. Current Status &amp; Percentage Labels */
#cardFrame #lblCurrentStatus {
    color: #64748B;
    font-size: 10px;
    font-weight: bold;
    border: none;
}

#cardFrame #lblPercentage {
    color: #1558A8;
    font-size: 11px;
    font-weight: bold;
    border: none;
}

/* 7. Progress Bar ka Modern Design */
#cardFrame QProgressBar {
    background-color: #F1F5F9; /* Background Track Color */
    border: none;
    border-radius: 4px;
    height: 8px; /* Patli line */
}

#cardFrame QProgressBar::chunk {
    background-color: #1558A8; /* Blue Fill Color */
    border-radius: 4px;
}

/* 8. Bottom Action Button (VIEW ANALYTICS) */
#cardFrame #btnAction {
    color: #1558A8;
    font-size: 11px;
    font-weight: bold;
    background-color: transparent;
    border: none;
}

/* 9. Bottom Note (Adjusted 3 days...) */
#cardFrame #lblBottomNote {
    color: #94A3B8;
    font-size: 10px;
    font-style: italic;
    border: none;
}</string>
