  <property name="styleSheet">
   <string notr="true">#centralwidget, 
#headerWidget, 
QFrame#titleFilterFrame,
QFrame#row3Frame, 
QFrame#row4Frame {
    background-color: transparent !important;
    border: none !important;
}

QFrame#row2Frame,
QFrame#frameCommonTopMetrics,        
QFrame#frameCommonIntensityMetrics,  
QFrame#frameTable {                  
    background-color: #FFFFFF !important;
    border-radius: 12px !important;
    border: 1px solid #E2E8F0 !important;
}

QFrame#frameHeartRate, 
QFrame#frameSleep, 
QFrame#frameMiniCardsContainer,  
QFrame#frameBarChart, 
QFrame#frameBloodPressure, 
QFrame#frameHydration, 
QFrame#frameStress, 
QFrame#frameMetabolic,
QFrame#tableHeaderContainer {
    background-color: transparent !important;
    border: none !important;
    border-radius: 0px !important;
}

QLabel {
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    border: none !important;
    background: transparent !important;
}

#sidebarWidget {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
    min-width: 260px; 
}

#appNameLabel {
    color: #1558A8;
    font-size: 18px;
    font-weight: 800;
    padding: 5px 15px 0px 15px;
    background-color: transparent;
    margin-top: 0px;
    border: none;
    min-height: 30px;
    max-height: 35px;
}

#sidebarWidget QPushButton {
    text-align: left;
    padding: 8px 20px;
    background-color: transparent;
    border: none;
    color: #6B7280; 
    font-size: 14px;
    font-weight: 600;
    margin: 2px 15px; 
    border-radius: 8px;
    min-height: 34px; 
}

#sidebarWidget QPushButton:hover {
    background-color: #F0F7FF; 
    color: #1558A8;            
}

QPushButton#analyticsButton {
    background-color: #F0F7FF !important;
    color: #1558A8 !important;
    font-weight: 900 !important;
    border-left: 4px solid #1558A8 !important;
    border-radius: 0px 8px 8px 0px !important;
}




QLabel#lblHeaderTitle { 
    color: #1558A8; 
    font-size: 16px; 
    font-weight: 800; 
    letter-spacing: 2px; 
    text-transform: uppercase; 
}

QLabel#lblAnalyticsTitle { 
    font-size: 22px; 
    font-weight: 900; 
    color: #0F172A; 
}

QLabel#lblAnalyticsSubtitle { 
    font-size: 13px; 
    color: #64748B; 
    margin-top: 2px; 
}

QLabel#lblHeartRateTitle, 
QLabel#lblSleepTitle, 
QLabel#lblIntensityTitle, 
QLabel#lblNutritionTitle { 
    color: #0F172A !important; 
    font-weight: 900 !important; 
    font-size: 16px !important; 
}

QLabel#lblIntensitySub {
    color: #8C98A4 !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: 1px !important;
}

QLabel#lblBloodPressureTitle, 
QLabel#lblHydrationTitle, 
QLabel#lblStressTitle, 
QLabel#lblMetabolicTitle {
    color: #8C98A4 !important; 
    font-size: 11px !important; 
    font-weight: 800 !important; 
    letter-spacing: 1px !important;
}

QLabel#lblBloodPressureValue, 
QLabel#lblHydrationValue, 
QLabel#lblStressValue, 
QLabel#lblMetabolicValue {
    color: #0F172A !important; 
    font-size: 26px !important; 
    font-weight: bold !important; 
}

QLabel#lblBloodPressureSub, 
QLabel#lblHydrationSub, 
QLabel#lblStressSub, 
QLabel#lblMetabolicSub {
    color: #94A3B8 !important; 
    font-size: 11px !important; 
    font-weight: normal !important; 
    margin-top: -2px;
}


QPushButton#syncDataButton {
    background-color: #1558A8 !important; 
    color: #FFFFFF !important; 
    font-weight: bold; 
    font-size: 13px; 
    border-radius: 8px; 
    padding: 8px 20px; 
    border: none;
}

QPushButton#syncDataButton:hover { 
    background-color: #0E417F !important; 
}

#headerWidget QPushButton { 
    background-color: transparent; 
    border: none; 
    padding: 5px; 
}

QTableWidget#TableWidget, 
QTableWidget#TableWidget * {
    background-color: transparent !important; 
    border: none !important;
    outline: none !important; 
    color: #0F172A !important; 
    font-size: 13px !important;
}

QTableWidget#TableWidget QHeaderView::section {
    background-color: transparent !important; 
    color: #8C98A4 !important; 
    font-weight: bold !important; 
    font-size: 11px !important; 
    padding: 5px 5px !important; 
    border: none !important; 
    border-bottom: 1px solid #E2E8F0 !important; 
    text-align: left !important; 
    text-transform: uppercase !important;
}

QTableWidget#TableWidget::item {
    color: #0F172A !important; 
    font-weight: 500 !important;
    padding: 0px 10px !important; 
    border-bottom: 1px solid #F8FAFC !important;
}

</string>
